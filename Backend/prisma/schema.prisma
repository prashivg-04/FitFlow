// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  TRAINER
  MEMBER
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())

  owner   Owner?
  trainer Trainer?
  member  Member?

  joinRequests JoinRequest[]
}

model Owner {
  id     String @id @default(uuid())
  userId String @unique

  gymName String
  address String
  city    String
  phone   String

  gymCode String @unique

  openingTime String
  closingTime String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  trainers Trainer[]
  members  Member[]

  joinRequests JoinRequest[]
}

enum JoinStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model JoinRequest {
  id      String     @id @default(uuid())
  ownerId String
  userId  String
  role    UserRole
  status  JoinStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner Owner @relation(fields: [ownerId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([ownerId, userId])
}

enum GymStatus {
  NONE
  PENDING
  ACTIVE
}

model Trainer {
  id      String  @id @default(uuid())
  userId  String  @unique
  ownerId String?

  specialization  String
  experienceYears Int
  preferredDays   String[]
  startTime       String
  endTime         String
  bio             String

  gymStatus GymStatus @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  owner Owner? @relation(fields: [ownerId], references: [id])

  trainerMembers TrainerMember[]

  workoutPrograms WorkoutProgram[]
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  ENDURANCE
  FLEXIBILITY
  GENERAL_FITNESS
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Member {
  id      String  @id @default(uuid())
  userId  String  @unique
  ownerId String?

  dateOfBirth     DateTime
  gender          Gender
  heightCm        Float
  weightKg        Float
  goal            FitnessGoal
  experienceLevel ExperienceLevel

  gymStatus GymStatus @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id])
  owner Owner? @relation(fields: [ownerId], references: [id])

  trainerMembers TrainerMember[]

  workoutAssignments WorkoutAssignment[]
}

model TrainerMember {
  trainerId String
  memberId  String @unique

  trainer Trainer @relation(fields: [trainerId], references: [id])
  member  Member  @relation(fields: [memberId], references: [id])

  @@id([trainerId, memberId])
}

// workouts

model WorkoutProgram {
  id        String @id @default(uuid())
  trainerId String

  title       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer Trainer             @relation(fields: [trainerId], references: [id])
  days    WorkoutProgramDay[]

  assignments WorkoutAssignment[]
}

model WorkoutProgramDay {
  id        String @id @default(uuid())
  programId String

  name       String
  orderIndex Int
  isRestDay  Boolean @default(false)

  program   WorkoutProgram    @relation(fields: [programId], references: [id])
  exercises WorkoutExercise[]

  assignments WorkoutAssignment[]

  @@unique([programId, orderIndex])
}

model WorkoutExercise {
  id           String @id @default(uuid())
  programDayId String

  name        String
  sets        Int
  reps        String
  restSeconds Int
  notes       String?
  orderIndex  Int

  programDay WorkoutProgramDay @relation(fields: [programDayId], references: [id])

  @@unique([programDayId, orderIndex])
}

enum AssignmentStatus {
  PENDING
  COMPLETED
}

model WorkoutAssignment {
  id String @id @default(uuid())

  memberId     String
  programId    String
  programDayId String

  assignedDate DateTime

  dayName String
  isRestDay Boolean

  status        AssignmentStatus @default(PENDING)
  completedDate DateTime?

  member     Member            @relation(fields: [memberId], references: [id])
  program    WorkoutProgram    @relation(fields: [programId], references: [id])
  programDay WorkoutProgramDay @relation(fields: [programDayId], references: [id])

  exercises WorkoutAssignmentExercise[]

  @@unique([memberId, assignedDate])
}

model WorkoutAssignmentExercise {
  id String @id @default(uuid())

  assignmentId String

  name        String
  sets        Int
  reps        String
  restSeconds Int
  notes       String?
  orderIndex  Int

  assignment WorkoutAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([assignmentId, orderIndex])
}